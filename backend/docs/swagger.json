{
    "swagger": "2.0",
    "info": {
        "description": "WsAI 项目 Swagger 文档",
        "title": "WsAI 后端接口",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:9091",
    "basePath": "/",
    "paths": {
        "/api/v1/AI/chatMessage/sessions": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "返回当前登录用户创建的所有聊天会话（通常按创建时间降序）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "会话管理"
                ],
                "summary": "获取当前用户的所有会话列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/session.GetUserSessionsResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/AI/chatMessage/sessions/stream": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "创建一个新会话，同时把用户的第一个问题发给 AI，使用 SSE 流式返回",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "会话管理"
                ],
                "summary": "创建新会话 + 发送第一个问题（SSE 流式返回）",
                "parameters": [
                    {
                        "description": "请求参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/session.CreateSessionAndSendFirstMessageRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE 错误事件",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/AI/chatMessage/sessions/{session_id}/messages": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "返回指定会话 ID 下的所有消息记录（按时间升序）",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "会话管理"
                ],
                "summary": "获取指定会话的全部历史消息",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话ID",
                        "name": "session_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/session.GetMeaasgeHistoryResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/AI/chatMessage/sessions/{session_id}/messages/stream": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "向指定的会话 ID 发送一条新消息，并使用 SSE 流式返回 AI 回答",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "会话管理"
                ],
                "summary": "向已有会话追加消息（SSE 流式返回）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话ID",
                        "name": "session_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "请求参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/session.SendMessageStreamRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSE 错误事件",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/image/recognize": {
            "post": {
                "description": "上传单张图片，服务端返回识别出的主要类别名称\n\n成功时：code=0，class_name 会有值\n失败时：code 为错误码（1001 参数错误 / 1002 服务器忙等），class_name 为空",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "图像识别"
                ],
                "summary": "上传图片进行分类/识别",
                "parameters": [
                    {
                        "type": "file",
                        "description": "要识别的图片文件（支持常见图片格式：jpg,png,gif等）",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "业务错误（code≠0）也返回 200，这是项目规范",
                        "schema": {
                            "$ref": "#/definitions/image.RecognizeImageResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/rag/documents": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "按更新时间倒序返回当前登录用户上传的全部文档及其解析状态。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 文档管理"
                ],
                "summary": "获取知识库文档列表",
                "responses": {
                    "200": {
                        "description": "服务异常；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "上传 PDF、Markdown 或纯文本文件。当前接口仅保存原始文件和文档记录，初始解析状态为待处理。",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 文档管理"
                ],
                "summary": "上传知识库文档",
                "parameters": [
                    {
                        "type": "file",
                        "description": "待上传的文档，仅支持 .pdf、.md、.txt",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "参数错误或服务异常；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/rag/documents/{document_id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "只能查看当前登录用户拥有的文档；响应包含文件信息、解析状态和切片数量。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 文档管理"
                ],
                "summary": "获取知识库文档详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "文档 ID",
                        "name": "document_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "参数错误、文档不存在或无访问权限；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "删除当前用户拥有的文档记录、会话关联、已保存的切片，以及上传的原始文件目录。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 文档管理"
                ],
                "summary": "删除知识库文档",
                "parameters": [
                    {
                        "type": "string",
                        "description": "文档 ID",
                        "name": "document_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "参数错误、文档不存在或无访问权限；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/rag/sessions/{session_id}/documents": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "仅返回当前登录用户拥有的指定会话关联的文档，按绑定时间正序排列。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 会话关联"
                ],
                "summary": "获取会话已绑定的知识库文档",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话 ID",
                        "name": "session_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "会话不存在、无访问权限或服务异常；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "为当前登录用户拥有的会话关联一个或多个本人文档；重复的关联会被忽略。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "RAG 会话关联"
                ],
                "summary": "为会话绑定知识库文档",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话 ID",
                        "name": "session_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "请求体，例如：{\\",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "参数错误、会话或文档不存在、无访问权限或服务异常；本项目业务错误仍使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/captcha": {
            "post": {
                "description": "向指定邮箱发送注册验证码",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "发送邮箱验证码",
                "parameters": [
                    {
                        "description": "邮箱参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.CaptchaRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "验证码发送成功",
                        "schema": {
                            "$ref": "#/definitions/user.CaptchaResponse"
                        }
                    },
                    "400": {
                        "description": "邮箱格式错误",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "429": {
                        "description": "发送过于频繁",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/email-login": {
            "post": {
                "description": "根据已注册邮箱和密码登录，成功后返回 JWT 令牌。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "邮箱登录",
                "parameters": [
                    {
                        "description": "邮箱登录参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.EmailLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "参数错误、邮箱不存在或密码错误；业务错误使用 HTTP 200 返回",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/login": {
            "post": {
                "description": "根据用户名和密码登录，返回 JWT 令牌",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "description": "登录参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "登录成功，返回令牌",
                        "schema": {
                            "$ref": "#/definitions/user.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "401": {
                        "description": "用户名或密码错误",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/logout": {
            "post": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "吊销当前 Access Token、撤销 Refresh Token，并清除 Refresh Cookie。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "退出登录",
                "responses": {
                    "200": {
                        "description": "Token 无效或服务异常",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/refresh": {
            "post": {
                "description": "浏览器自动携带 wsai_refresh_token Cookie。服务端验证并一次性消费旧 Refresh Token，返回新的 Access Token 并轮换 Cookie。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "刷新 Access Token",
                "parameters": [
                    {
                        "type": "string",
                        "description": "HttpOnly Refresh Token Cookie（浏览器自动携带）",
                        "name": "Cookie",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Refresh Token 无效、已过期或服务异常",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        },
        "/api/v1/user/users": {
            "post": {
                "description": "通过邮箱、密码和验证码注册新用户，成功后直接返回登录令牌",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户认证"
                ],
                "summary": "用户注册",
                "parameters": [
                    {
                        "description": "注册参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/user.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "注册成功，返回令牌",
                        "schema": {
                            "$ref": "#/definitions/user.RegisterResponse"
                        }
                    },
                    "400": {
                        "description": "参数错误或验证码错误",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    },
                    "409": {
                        "description": "用户已存在",
                        "schema": {
                            "$ref": "#/definitions/common.Response"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "code.Code": {
            "type": "integer",
            "format": "int64",
            "enum": [
                1000,
                2001,
                2002,
                2003,
                2004,
                2005,
                2006,
                2007,
                2008,
                2009,
                2010,
                3001,
                4001,
                5001,
                5002,
                5003
            ],
            "x-enum-varnames": [
                "CodeSuccess",
                "CodeInvalidParams",
                "CodeUserExist",
                "CodeUserNotExist",
                "CodeInvalidPassword",
                "CodeNotMatchPassword",
                "CodeInvalidToken",
                "CodeNotLogin",
                "CodeInvalidCaptcha",
                "CodeRecordNotFound",
                "CodeIllegalPassword",
                "CodeForbidden",
                "CodeServerBusy",
                "AIModelNotFind",
                "AIModelCannotOpen",
                "AIModelFail"
            ]
        },
        "common.Response": {
            "type": "object",
            "properties": {
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                }
            }
        },
        "image.RecognizeImageResponse": {
            "type": "object",
            "properties": {
                "class_name": {
                    "type": "string"
                },
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                }
            }
        },
        "model.History": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string"
                },
                "is_user": {
                    "type": "boolean"
                }
            }
        },
        "model.SessionInfo": {
            "type": "object",
            "properties": {
                "sessionId": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "session.CreateSessionAndSendFirstMessageRequest": {
            "type": "object",
            "required": [
                "question"
            ],
            "properties": {
                "document_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "modelType": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                }
            }
        },
        "session.GetMeaasgeHistoryResponse": {
            "type": "object",
            "properties": {
                "history": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.History"
                    }
                },
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                }
            }
        },
        "session.GetUserSessionsResponse": {
            "type": "object",
            "properties": {
                "sessions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.SessionInfo"
                    }
                },
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                }
            }
        },
        "session.SendMessageStreamRequest": {
            "type": "object",
            "required": [
                "question",
                "sessionId"
            ],
            "properties": {
                "modelType": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "sessionId": {
                    "type": "string"
                }
            }
        },
        "user.CaptchaRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "email": {
                    "type": "string"
                }
            }
        },
        "user.CaptchaResponse": {
            "type": "object",
            "properties": {
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                }
            }
        },
        "user.EmailLoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "user.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "user.LoginResponse": {
            "type": "object",
            "properties": {
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        },
        "user.RegisterRequest": {
            "type": "object",
            "required": [
                "email"
            ],
            "properties": {
                "captcha": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "user.RegisterResponse": {
            "type": "object",
            "properties": {
                "status_code": {
                    "$ref": "#/definitions/code.Code"
                },
                "status_msg": {
                    "type": "string"
                },
                "token": {
                    "type": "string"
                }
            }
        }
    }
}